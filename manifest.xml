<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>3c8dfdd6-24ca-41aa-8579-f578d126ba9c</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Rcc_Web_Addin"/>
  <Description DefaultValue="A template to get started."/>
  <IconUrl DefaultValue="https://localhost:5173/rcc-addin/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:5173/rcc-addin/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help"/>
  <AppDomains>
    <AppDomain>https://localhost:5173</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:5173/rcc-addin/index.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- PESTAÑA PERSONALIZADA -->
            <CustomTab id="TabRichardAddin">

              <Group id="GroupPython">
                <Label resid="GroupPython.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="BtnTaskpaneRuta">
                  <Label resid="BtnTaskpaneRuta.Label"/>
                  <Supertip>
                    <Title resid="BtnTaskpaneRuta.Label"/>
                    <Description resid="BtnTaskpaneRuta.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>TaskpaneRutaId</TaskpaneId>
                    <SourceLocation resid="TaskpaneRuta.Url"/>
                  </Action>
                </Control>
              </Group>

              <Group id="GroupProductividad">
                <Label resid="GroupProductividad.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>

                <Control xsi:type="Button" id="BtnMayuscula">
                  <Label resid="BtnMayuscula.Label"/>
                  <Supertip>
                    <Title resid="BtnMayuscula.Label"/>
                    <Description resid="BtnMayuscula.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>Mayuscula_Click</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="BtnMinuscula">
                  <Label resid="BtnMinuscula.Label"/>
                  <Supertip>
                    <Title resid="BtnMinuscula.Label"/>
                    <Description resid="BtnMinuscula.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>Minuscula_Click</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="BtnAgruparCeldas">
                  <Label resid="BtnAgruparCeldas.Label"/>
                  <Supertip>
                    <Title resid="BtnAgruparCeldas.Label"/>
                    <Description resid="BtnAgruparCeldas.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>Agruparceldas_Click</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="BtnOracion">
                  <Label resid="BtnOracion.Label"/>
                  <Supertip>
                    <Title resid="BtnOracion.Label"/>
                    <Description resid="BtnOracion.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>Oracion_Click</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="BtnPrimera">
                  <Label resid="BtnPrimera.Label"/>
                  <Supertip>
                    <Title resid="BtnPrimera.Label"/>
                    <Description resid="BtnPrimera.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>Primera_Click</FunctionName>
                  </Action>
                </Control>

                <Control xsi:type="Button" id="BtnPdf">
                  <Label resid="BtnPdf.Label"/>
                  <Supertip>
                    <Title resid="BtnPdf.Label"/>
                    <Description resid="BtnPdf.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>pdf_Click</FunctionName>
                  </Action>
                </Control>
                
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

              </Group>

              
              <Label resid="TabRichardAddin.Label"/>
            </CustomTab>  

          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:5173/rcc-addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:5173/rcc-addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:5173/rcc-addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:5173/rcc-addin/index.html"/>
        <bt:Url id="TaskpaneRuta.Url" DefaultValue="https://localhost:5173/rcc-addin/index.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:5173/rcc-addin/index.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with your sample add-in!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="Commands Group"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Show Task Pane"/>

        <!-- Strings agregados para la pestaña personalizada -->
        <bt:String id="TabRichardAddin.Label" DefaultValue="RichardAddin"/>
        <bt:String id="GroupPython.Label" DefaultValue="Python"/>
        <bt:String id="BtnTaskpaneRuta.Label" DefaultValue="Ruta"/>
        
        <bt:String id="GroupProductividad.Label" DefaultValue="Productividad"/>
        <bt:String id="BtnMayuscula.Label" DefaultValue="Mayuscula"/>
        <bt:String id="BtnMinuscula.Label" DefaultValue="Minuscula"/>
        <bt:String id="BtnAgruparCeldas.Label" DefaultValue="combinar"/>
        <bt:String id="BtnOracion.Label" DefaultValue="Oracion"/>
        <bt:String id="BtnPrimera.Label" DefaultValue="Primera"/>
        <bt:String id="BtnPdf.Label" DefaultValue="PDF"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Your sample add-in loaded successfully. Go to the HOME tab and click the 'Show Task Pane' button to get started."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Click to Show a Taskpane"/>
        <!-- Tooltips agregados -->
        <bt:String id="BtnTaskpaneRuta.Tooltip" DefaultValue="Ruta para definir donde estan los py"/>
        
        <bt:String id="BtnMayuscula.Tooltip" DefaultValue="Convertir selección a mayúsculas"/>
        <bt:String id="BtnMinuscula.Tooltip" DefaultValue="Convertir selección a minúsculas"/>
        <bt:String id="BtnAgruparCeldas.Tooltip" DefaultValue="Combinar celdas"/>
        <bt:String id="BtnOracion.Tooltip" DefaultValue="Formato tipo oración"/>
        <bt:String id="BtnPrimera.Tooltip" DefaultValue="Primera letra en mayúscula"/>
        <bt:String id="BtnPdf.Tooltip" DefaultValue="Exportar a PDF"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>